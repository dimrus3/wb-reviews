      "name": "TelegramUpdate",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        420
      ],
      "id": "9802b6a9-f4cd-5bd2-b73b-76485b406fdb",
      "credentials": {
        "telegramApi": {
          "id": "9hvA7Tk3lvUpnZ9y",
          "name": "Telegram Bot"
        }
      },
      "webhookId": "ea9f60ae-c2e9-48bf-aa0e-8bf729ddcdee"
