    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "fits-cond-1",
              "leftValue": "={{ $('Prepare Message').item.json.fits }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Fits Caption?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1240,
        180
      ],
      "id": "fits-caption-node-1"
    },
    {
      "parameters": {
        "jsCode": "\nconst s = $('Split Posts').item.json;\nconst header = '📝 <b>Новый пост на одобрение</b>\\n\\n'\n  + '<b>Артикул WB:</b> ' + s.article + '\\n'\n  + '<b>Версия:</b> ' + s.version + '\\n\\n'\n  + '━━━━━━━━━━━━━━━\\n\\n';\nconst text = s.text || '';\nconst fits = text.length < 850;\nreturn [{ json: { ...s, caption: header + (fits ? text : ''), fits: fits } }];\n"
      },
      "name": "Prepare Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        180
      ],
      "id": "prepare-message-node-1"
    }
