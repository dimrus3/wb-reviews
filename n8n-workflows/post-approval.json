                      "callback_data": "=revise_{{ $('Split Posts').item.json.product_id }}"
                    }
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "⏭ Пропустить",
                    "additionalFields": {
                      "callback_data": "=skip_{{ $('Split Posts').item.json.product_id }}"
                    }
                  }
                ]
              }
            }
          ]
        }
