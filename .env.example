# ============================================
# TELEGRAM
# ============================================
# ID пользователя Telegram (владельца системы)
# Получить можно через @userinfobot
ALLOWED_USER_ID=

# ID канала для публикации (например: -1001234567890)
# Бот должен быть администратором канала
TELEGRAM_CHANNEL_ID=

# ============================================
# LLM API (OpenAI-совместимый)
# ============================================
# Base URL API (например: https://api.openai.com/v1)
LLM_BASE_URL=

# API ключ
LLM_API_KEY=

# Название модели (например: gpt-4, gpt-3.5-turbo)
LLM_MODEL=gpt-4

# Таймаут запроса в секундах
LLM_TIMEOUT=300  # long generation at 8000 max_tokens can exceed 120s

# Максимум токенов в ответе
LLM_MAX_TOKENS=2000

# Дневной лимит запросов к модели
LLM_DAILY_LIMIT=100

# ============================================
# PLAYWRIGHT / SCRAPER
# ============================================
# Headless режим браузера (true/false)
PLAYWRIGHT_HEADLESS=true

# Таймаут операций в миллисекундах
PLAYWRIGHT_TIMEOUT=60000

# Максимум отзывов для сбора
SCRAPER_MAX_REVIEWS=100

# Максимум вопросов для сбора
SCRAPER_MAX_QUESTIONS=50

# Количество попыток при сбоях
SCRAPER_RETRY_ATTEMPTS=3

# Задержка между попытками в секундах
SCRAPER_RETRY_DELAY=5

# ============================================
# ПУБЛИКАЦИИ
# ============================================
# Часовой пояс для расписания
PUBLICATION_TIMEZONE=Asia/Novosibirsk

# Время публикаций (JSON-список или через запятую)
PUBLICATION_TIMES=["09:00","10:00","11:00","12:00","13:00","14:00","15:00","16:00","17:00","18:00","19:00","20:00","21:00"]

# Максимум публикаций в день (предохранитель, включая ручные одобрения)
MAX_PUBLICATIONS_PER_DAY=15

# Режим dry-run (true - не публиковать реально, только тесты)
DRY_RUN=true

# ============================================
# MAX (max.ru) — дублирование постов в мессенджер MAX
# ============================================
# Токен бота MAX (из @MasterBot). Передаётся в заголовке Authorization БЕЗ "Bearer".
MAX_BOT_TOKEN=
# ID канала/чата MAX — бот должен быть админом канала.
# Узнать: GET http://localhost:8100/max/chats после добавления бота в канал
MAX_CHAT_ID=
MAX_API_BASE=https://platform-api2.max.ru
MAX_PUBLISH=true

# ============================================
# API
# ============================================
# Хост API сервера
API_HOST=0.0.0.0

# Порт API сервера
API_PORT=8000

# ============================================
# БЕЗОПАСНОСТЬ
# ============================================
# Разрешённые домены Wildberries (через запятую)
ALLOWED_DOMAINS=wildberries.ru,www.wildberries.ru
